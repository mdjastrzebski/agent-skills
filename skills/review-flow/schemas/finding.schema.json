{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "lens": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "file": {
      "type": "string",
      "minLength": 1
    },
    "line_start": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "line_end": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "category": {
      "type": "string",
      "enum": [
        "bug",
        "security",
        "performance",
        "test-gap",
        "maintainability",
        "platform"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "string",
      "minLength": 1
    },
    "suggested_fix": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "lens",
    "file",
    "line_start",
    "line_end",
    "category",
    "severity",
    "title",
    "claim",
    "evidence"
  ],
  "additionalProperties": false
}
